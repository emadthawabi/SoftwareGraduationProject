# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# Optional: overrides the URL built from POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://legaluser:change-me@127.0.0.1:5433/legalai

# Gemini embeddings (keep real keys only in .env).
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
